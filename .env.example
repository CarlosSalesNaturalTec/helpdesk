# =============================================================================
# HelpDesk — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All variables marked [REQUIRED] must be set for the application to function.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Development: postgresql://postgres:postgres@localhost:5432/helpdesk
# Production:  Uses Cloud SQL Proxy or direct connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdesk

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# [REQUIRED] Secret key for JWT token signing (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ---------------------------------------------------------------------------
# Email (SendGrid)
# ---------------------------------------------------------------------------
# SendGrid API key for sending email notifications
# Leave empty to disable email sending in development
SENDGRID_API_KEY=

# Sender email address for system notifications
FROM_EMAIL=noreply@helpdesk.local

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Allowed origin for CORS headers in production
# Set to the Cloud Storage URL or custom domain in production
# Leave empty for development (defaults to '*')
ALLOWED_ORIGIN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the backend listens on (default: 3001)
PORT=3001

# Host address to bind (default: 0.0.0.0)
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# API base URL for the frontend build
# Set to the Cloud Run service URL in production
# Leave empty for development (defaults to http://localhost:3001)
VITE_API_URL=
