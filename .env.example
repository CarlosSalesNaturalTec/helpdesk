# =============================================================================
# HelpDesk — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All variables marked [REQUIRED] must be set for the application to function.
# =============================================================================

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------
# Name of the application. Defaults to "SOLUTUS" when unset.
APP_NAME=

# Name of the client/organization running this instance. Defaults to
# "Instituto Setes" when unset. The system displays "${APP_NAME} — ${CLIENT_NAME}"
# (or just APP_NAME when CLIENT_NAME is empty) in the browser title, navbar,
# login screen, PDF report header/filename and email signatures.
CLIENT_NAME=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Development: postgresql://postgres:postgres@localhost:5432/helpdesk
# Production:  Uses Cloud SQL Proxy or direct connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdesk

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# [REQUIRED] Secret key for JWT token signing (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ---------------------------------------------------------------------------
# Email (SendGrid)
# ---------------------------------------------------------------------------
# SendGrid API key for sending email notifications
# Leave empty to disable email sending in development
SENDGRID_API_KEY=

# Sender email address for system notifications
# Must be a verified sender/domain in SendGrid, otherwise delivery is rejected.
# Defaults to helpdesk@naturaltec.com.br when unset.
EMAIL_FROM=helpdesk@naturaltec.com.br

# Base URL of the frontend, used to build the ticket links inside notification
# emails (${FRONTEND_URL}/chamados/{id}).
# Development defaults to http://localhost:5173 when unset.
# In production, point this at the custom domain / load balancer: the direct
# Cloud Storage bucket endpoint does not rewrite SPA routes, so deep links only
# resolve behind a load balancer with an index.html fallback.
FRONTEND_URL=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Allowed origin for CORS headers in production
# Set to the Cloud Storage URL or custom domain in production
# Leave empty for development (defaults to '*')
ALLOWED_ORIGIN=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the backend listens on (default: 3001)
PORT=3001

# Host address to bind (default: 0.0.0.0)
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# API base URL for the frontend build
# Set to the Cloud Run service URL in production
# Leave empty for development (defaults to http://localhost:3001)
VITE_API_URL=

# Same as APP_NAME / CLIENT_NAME above, but read at frontend build time
# (Vite only exposes VITE_-prefixed variables to client code and to
# index.html's %VITE_APP_NAME% / %VITE_CLIENT_NAME% substitution).
# Same defaults: "SOLUTUS" and "Instituto Setes".
VITE_APP_NAME=
VITE_CLIENT_NAME=

# ---------------------------------------------------------------------------
# Google Cloud Storage — Ticket Attachments
# ---------------------------------------------------------------------------
# [REQUIRED for attachments] Name of the GCS bucket used to store ticket attachments.
# The bucket must exist and be configured with:
#   - Uniform bucket-level access enabled
#   - allUsers / Storage Object Viewer permission (for public access)
#   - CORS configured to allow the frontend origin
#   - The Cloud Run service account must have the Storage Object Admin role on this bucket
#
# Authentication uses Application Default Credentials (ADC) automatically in Cloud Run.
# For local development with a real bucket, run:
#   gcloud auth application-default login
#
# Example: GCS_BUCKET_NAME=helpdesk-attachments-prod
GCS_BUCKET_NAME=

